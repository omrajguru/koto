{
  "name": "koto",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "windows": "react-native run-windows",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen:windows": "react-native codegen-windows"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-windows": "^0.83.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-windows/find-dotnet-tools": "^0.84.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@rnx-kit/jest-preset": "^0.3.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "Koto",
      "namespace": "Koto",
      "template": "cpp-app"
    }
  },
  "codegenConfig": {
    "name": "KotoSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "windows": {
      "namespace": "KotoCodegen",
      "outputDirectory": "windows/Koto/codegen",
      "separateDataTypes": false
    }
  }
}
